# Copier en .env et remplir. Les valeurs ne sont jamais committées (voir le README privé).
# Identifiant de l'app (UUID), généré sur la page « Programs API keys » du profil QOALA
SIGCHI_CLIENT_ID=
# Optionnel, dev uniquement : token utilisateur (neutralisé au build). Normalement récupéré par Log In.
SIGCHI_USER_TOKEN=
# Valeur de l'en-tête de signature de l'app
SIGCHI_APP_SIGNATURE=
# Page de login externe
SIGCHI_LOGIN_URL=
# Lecture du programme et des listes de l'utilisateur
SIGCHI_CLOUD_READ_URL=
# Liste des conférences (données publiques)
SIGCHI_PROGRAM_LIST_URL=
# Programme d'une conférence ; gabarit avec {shortName} et {year}
SIGCHI_PROGRAM_URL=
